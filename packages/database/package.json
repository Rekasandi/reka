{
  "name": "@reka/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema/index.ts --format esm,cjs --dts",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed/index.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@reka/types": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.40.0"
  },
  "devDependencies": {
    "@reka/tsconfig": "workspace:*",
    "@types/node": "^22.13.9",
    "drizzle-kit": "^0.30.5",
    "tsup": "^8.4.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
