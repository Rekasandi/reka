f# Database (NeonDB PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/reka?sslmode=require

# Redis (BullMQ / Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# App URLs
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Auth (Better Auth): email + password, magic links and GitHub. Generate the secret with `openssl rand -hex 32`.
BETTER_AUTH_SECRET=change-me-to-a-random-64-hex-string

# GitHub App Integration
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# OAuth callback for GitHub sign-in: <WEB_URL>/api/auth/callback/github (the web app proxies /api to the API)
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/callback/github
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Email (SMTP) - used for workspace invitations and opt-in notification emails.
# Leave SMTP_HOST empty to disable email; invitation links can still be copied manually.
# Port 587 uses STARTTLS; port 465 uses implicit TLS (or set SMTP_SECURE=true).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="REKA <no-reply@example.com>"
SMTP_REPLY_TO=
# SMTP_IGNORE_TLS=true  # only for self-signed mail servers; disables certificate checks (see docs/EMAIL.md)
